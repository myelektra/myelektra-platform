{
  "name": "@myelektra/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "npm run toml:watch && astro build && npm run remove-draft-from-sitemap",
    "build:local": "tinacms build && astro build",
    "preview": "astro build && npm run remove-draft-from-sitemap && astro preview",
    "astro": "astro",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo",
    "toml:watch": "node scripts/toml-watcher.mjs",
    "generate-favicons": "node ./scripts/generate-favicons.mjs",
    "remove-draft-from-sitemap": "node ./scripts/remove-draft-from-sitemap.mjs",
    "format": "prettier -w ./src"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/react": "^4.0.0",
    "@floating-ui/dom": "^1.7.6",
    "@preline/dropdown": "^4.1.3",
    "@preline/overlay": "^4.1.3",
    "@preline/select": "^4.1.3",
    "@tinacms/cli": "^2.0.0",
    "aos": "^2.3.4",
    "astro": "^7.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "lucide": "^1.14.0",
    "marked": "^17.0.6",
    "motion": "^12.38.0",
    "preline": "^4.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smoothscroll-for-websites": "^1.5.1",
    "tinacms": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/sitemap": "3.7.3",
    "@realfavicongenerator/generate-favicon": "^0.8.0",
    "@realfavicongenerator/image-adapter-node": "^0.8.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prettier-plugin-toml": "2.0.3",
    "prop-types": "^15.8.1",
    "rehype-external-links": "^3.0.0",
    "remark-toc": "^9.0.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.2.2",
    "toml": "^4.1.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.115.0",
    "xml2js": "^0.6.2"
  },
  "overrides": {
    "yaml": "^2.8.3",
    "js-yaml@>=4.0.0 <4.2.0": "^4.2.0"
  }
}
