---
import '../styles/index.css';
import { client } from '../../tina/__generated__/client';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Myelektra - Revenue Growth Partner' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', path: '/' },
  { label: 'Solutions', path: '/solutions', submenu: [
    { label: 'Revenue Intelligence', path: '/solutions' },
    { label: 'Pipeline Builder', path: '/solutions' },
    { label: 'Revenue Engine', path: '/solutions' },
    { label: 'AI Sales Transformation', path: '/solutions' },
    { label: 'Fractional Revenue Office', path: '/solutions' },
  ]},
  { label: 'Industries', path: '/industries' },
  { label: 'Pricing', path: '/pricing' },
  { label: 'Academy', path: '/academy' },
  { label: 'About', path: '/about' },
  { label: 'Contact Us', path: '/contact', submenu: [
    { label: 'Get Quote Here', path: '/get-quote-here-new' },
    { label: 'Book Online Meeting', path: '/consultation' },
  ]},
];

let brandData = { company: 'PT. Myelektra Solusi Indonesia', logo: '', tagline: '', positioning: '', phone: '', address: { line1: '38th Floor, 88 Office', line2: 'Kota Kasablanka, South Jakarta', country: 'Indonesia' }, social: { linkedin: '#', instagram: '#' }, founder: { name: '', title: '' } };
let footerData = { columns: [], copyright: '' };
try {
  const brandResult = await client.request({ query: `query { brand(relativePath: "index.json") { company tagline positioning phone address { line1 line2 country } social { linkedin instagram } } }` });
  if (brandResult.data?.brand) brandData = { ...brandData, ...brandResult.data.brand };
} catch {}
try {
  const footerResult = await client.request({ query: `query { footer(relativePath: "index.json") { columns { title type links { label path highlight } } copyright } }` });
  if (footerResult.data?.footer) footerData = { ...footerData, ...footerResult.data.footer };
} catch {}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Myelektra</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    #mobile-menu-inner { transform: translateX(100%); }
    .mobile-overlay.open #mobile-menu-inner { transform: translateX(0) !important; }
  </style>
</head>
<body>
  <!-- Header -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo-link">
        <img src="/logo-myelektra.png" alt="Myelektra" style="height:28px;width:auto" />
        <span style="display:flex;align-items:baseline;gap:0">
          <span style="color:#000;font-size:28px;line-height:1;font-family:'Plus Jakarta Sans','Inter',sans-serif;font-weight:700">myelektra</span>
          <span style="color:#1877F2;font-size:14px;line-height:1">.com</span>
        </span>
      </a>

      <nav class="desktop-nav">
        {navItems.map((item) => (
          <div class="nav-dropdown" set:html={undefined}>
            <a href={item.path} class={`nav-link${currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path)) ? ' active-teal' : ''}`}>
              {item.label}
              {item.submenu && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
              )}
            </a>
            {item.submenu && (
              <div class="nav-dropdown-menu" style="display:none" onmouseenter="this.style.display='block'" onmouseleave="this.style.display='none'">
                {item.submenu.map((sub) => (
                  <a href={sub.path} class="dropdown-item">
                    {sub.label}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      <a href="/consultation" class="header-cta">Book an Online Meeting</a>

      <button class="hamburger" onclick="toggleMobile()" aria-label="Toggle menu">
        <svg id="menu-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="menu-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M6 6l12 12M6 18L18 6"/></svg>
      </button>
    </div>
  </header>

  <!-- Mobile Overlay -->
  <div id="mobile-overlay" class="mobile-overlay" onclick="if(event.target===this)closeMobile()">
    <div id="mobile-menu-inner" class="mobile-nav-inner">
      {navItems.map((item) => (
        <div>
          {item.submenu ? (
            <>
              <button class="mobile-submenu-toggle" onclick="toggleSubmenu('sub-{item.path}')">
                {item.label}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div id="sub-{item.path}" class="mobile-submenu" style="display:none">
                {item.submenu.map((sub) => (
                  <a href={sub.path} onclick="closeMobile()">{sub.label}</a>
                ))}
              </div>
            </>
          ) : (
            <a href={item.path} class="mobile-nav-link" onclick="closeMobile()">{item.label}</a>
          )}
        </div>
      ))}
      <div class="mobile-divider">
        <a href="/consultation" class="mobile-cta" onclick="closeMobile()">Book an Online Meeting</a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <main style="padding-top:72px">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-navy-dark text-text-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
        <div>
          <a href="/" style="display:flex;align-items:center;gap:8px;margin-bottom:16px;text-decoration:none">
            <img src="/logo-myelektra.png" alt="Myelektra" style="height:28px;width:auto" />
            <span style="display:flex;align-items:baseline;gap:0">
              <span style="color:white;font-size:28px;line-height:1;font-family:'Plus Jakarta Sans','Inter',sans-serif;font-weight:700">myelektra</span>
              <span style="color:#1877F2;font-size:14px;line-height:1">.com</span>
            </span>
          </a>
          <p class="text-teal text-sm font-semibold mb-1">{brandData.positioning || 'Your Revenue Growth Partner'}</p>
          <p class="text-text-dark/60 text-sm mb-4">{brandData.tagline || 'We Build Revenue Systems, Not Just Lead Lists.'}</p>
          <div class="text-text-dark/60 text-xs leading-relaxed mb-4 space-y-0.5">
            <p class="font-semibold text-text-dark/70">Corporate Office</p>
            <p>{brandData.address?.line1 || '38th Floor, 88 Office'}</p>
            <p>{brandData.address?.line2 || 'Kota Kasablanka, South Jakarta'}</p>
            <p>{brandData.address?.country || 'Indonesia'}</p>
          </div>
          <div style="display:flex;gap:12px">
            <a href={brandData.social?.linkedin || '#'} target="_blank" rel="noopener noreferrer" class="text-text-dark/60 hover:text-teal transition-colors" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href={brandData.social?.instagram || '#'} target="_blank" rel="noopener noreferrer" class="text-text-dark/60 hover:text-teal transition-colors" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          </div>
        </div>

        <div>
          <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Solutions</h4>
          <ul class="space-y-2.5">
            {['Revenue Intelligence','Pipeline Builder','Revenue Engine','AI Sales Transformation','Fractional Revenue Office'].map((s) => (
              <li><a href="/solutions" class="text-text-dark/60 hover:text-teal text-sm transition-colors">{s}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Company</h4>
          <ul class="space-y-2.5">
            <li><a href="/about" class="text-text-dark/60 hover:text-teal text-sm transition-colors">About</a></li>
            <li><a href="/industries" class="text-text-dark/60 hover:text-teal text-sm transition-colors">Industries</a></li>
            <li><a href="/academy" class="text-text-dark/60 hover:text-teal text-sm transition-colors">Academy</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Contact</h4>
          <ul class="space-y-2.5">
            <li class="text-text-dark/70 text-sm font-medium">{brandData.company || 'PT. Myelektra Solusi Indonesia'}</li>
            <li><a href={`tel:${brandData.phone || '+622129636761'}`} class="text-text-dark/60 hover:text-teal text-sm transition-colors">{brandData.phone || '+62 21 29636761'}</a></li>
            <li><a href="/get-quote-here-new" class="text-text-dark/60 hover:text-teal text-sm transition-colors">Get Quote Here</a></li>
            <li><a href="/consultation" class="text-sm transition-colors text-teal hover:text-teal-hover font-medium">Book an Online Meeting</a></li>
          </ul>
        </div>
      </div>

      <div class="mt-12 pt-8 border-t border-white/10">
        <p class="text-text-dark/40 text-xs leading-relaxed mb-4">Meetings and revenue outcomes are not guaranteed. Results depend on market conditions, offer relevance, buyer readiness, domain reputation, and the client's sales process.</p>
        <p class="text-text-dark/40 text-xs">&copy; {new Date().getFullYear()} Myelektra.com. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script>
    function toggleMobile() {
      const overlay = document.getElementById('mobile-overlay');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');
      const isOpen = overlay.classList.contains('open');
      overlay.classList.toggle('open');
      document.body.style.overflow = isOpen ? '' : 'hidden';
      openIcon.style.display = isOpen ? '' : 'none';
      closeIcon.style.display = isOpen ? 'none' : '';
    }
    function closeMobile() {
      const overlay = document.getElementById('mobile-overlay');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
      document.getElementById('menu-icon-open').style.display = '';
      document.getElementById('menu-icon-close').style.display = 'none';
    }
    function toggleSubmenu(id) {
      const el = document.getElementById(id);
      el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobile();
    });

    const navDrops = document.querySelectorAll('.nav-dropdown');
    navDrops.forEach(drop => {
      const menu = drop.querySelector('.nav-dropdown-menu');
      if (!menu) return;
      let timeout;
      drop.addEventListener('mouseenter', () => { clearTimeout(timeout); menu.style.display = 'block'; });
      drop.addEventListener('mouseleave', () => { timeout = setTimeout(() => { menu.style.display = 'none'; }, 100); });
      menu.addEventListener('mouseenter', () => { clearTimeout(timeout); menu.style.display = 'block'; });
      menu.addEventListener('mouseleave', () => { menu.style.display = 'none'; });
    });

    let scrolled = false;
    window.addEventListener('scroll', () => {
      const header = document.querySelector('.site-header');
      const shouldScroll = window.scrollY > 20;
      if (shouldScroll !== scrolled) {
        scrolled = shouldScroll;
        header.classList.toggle('scrolled', scrolled);
      }
    }, { passive: true });
  </script>
</body>
</html>
