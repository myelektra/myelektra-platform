---
import BaseLayout from '../layouts/BaseLayout.astro';
import { client } from '../../tina/__generated__/client';

let pageData = {
  title: 'Consultation',
  description: 'Book a free consultation.',
  heroHeadline: 'Book a Free Consultation',
  heroSubtitle: 'Let\'s discuss your revenue goals and find the right solution for your business.',
  formTitle: 'Schedule Your Consultation',
  formDesc: 'Fill in your details and we\'ll get back to you within 24 hours to schedule your free consultation.',
  ctaHeadline: 'Prefer to Call?',
  ctaBody: 'You can also reach us directly to schedule your consultation.',
  ctaButtonLabel: 'Call +62 21 29636761',
  ctaButtonPath: 'tel:+622129636761'
};

try {
  const r = await client.request({
    query: `query { page(relativePath: "consultation.mdx") { heroHeadline heroSubtitle formTitle formDesc ctaHeadline ctaBody ctaButtonLabel ctaButtonPath } }`
  });
  if (r.data?.page) {
    const d = r.data.page;
    Object.keys(pageData).forEach(k => { if ((d as any)[k]) (pageData as any)[k] = (d as any)[k]; });
  }
} catch {}
---

<BaseLayout title={pageData.title} description={pageData.description}>
  <section class="section-light section-padding" style="background:linear-gradient(135deg, rgba(11,17,32,0.92), rgba(0,82,204,0.85));min-height:40vh;display:flex;align-items:center">
    <div class="hero-grid-bg"></div>
    <div class="hero-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{pageData.heroHeadline}</h1>
      <p class="text-lg md:text-xl text-white/80 max-w-3xl mx-auto">{pageData.heroSubtitle}</p>
    </div>
  </section>

  <section class="section-gray section-padding">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <div class="lg:col-span-3">
          <div class="card">
            <h2 class="text-2xl font-bold text-navy mb-2">{pageData.formTitle}</h2>
            <p class="text-text-secondary mb-6">{pageData.formDesc}</p>
            <form class="space-y-5" action="https://formsubmit.co/info@myelektra.com" method="POST">
              <input type="hidden" name="_subject" value="New Consultation Booking" />
              <input type="hidden" name="_captcha" value="false" />
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div><label class="block text-sm font-medium text-navy mb-1.5">First Name *</label><input type="text" name="firstName" required class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
                <div><label class="block text-sm font-medium text-navy mb-1.5">Last Name *</label><input type="text" name="lastName" required class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
              </div>
              <div><label class="block text-sm font-medium text-navy mb-1.5">Email *</label><input type="email" name="email" required class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
              <div><label class="block text-sm font-medium text-navy mb-1.5">Phone Number</label><input type="tel" name="phone" class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
              <div><label class="block text-sm font-medium text-navy mb-1.5">Company *</label><input type="text" name="company" required class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
              <div><label class="block text-sm font-medium text-navy mb-1.5">Job Title</label><input type="text" name="jobTitle" class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
              <div><label class="block text-sm font-medium text-navy mb-1.5">Interested Solution</label>
                <select name="solution" class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white">
                  <option value="">Select a solution</option>
                  <option value="revenue-intelligence">Revenue Intelligence</option>
                  <option value="pipeline-builder">Pipeline Builder</option>
                  <option value="revenue-engine">Revenue Engine</option>
                  <option value="ai-sales">AI Sales Transformation</option>
                  <option value="fractional-revenue">Fractional Revenue Office</option>
                  <option value="not-sure">Not Sure Yet</option>
                </select>
              </div>
              <div><label class="block text-sm font-medium text-navy mb-1.5">Message</label><textarea name="message" rows="4" class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" placeholder="Tell us about your revenue goals or challenges..."></textarea></div>
              <button type="submit" class="btn btn-primary w-full" style="padding:14px">Book Consultation</button>
            </form>
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="card mb-6">
            <h3 class="font-semibold text-navy mb-4">What to Expect</h3>
            <ul class="space-y-3">
              <li class="flex items-start"><span style="flex-shrink:0;width:24px;height:24px;background:rgba(24,119,242,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#1877F2;font-size:12px;margin-right:10px;margin-top:2px">✓</span><span class="text-sm text-text-secondary">30-minute discovery call</span></li>
              <li class="flex items-start"><span style="flex-shrink:0;width:24px;height:24px;background:rgba(24,119,242,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#1877F2;font-size:12px;margin-right:10px;margin-top:2px">✓</span><span class="text-sm text-text-secondary">Needs assessment and goal alignment</span></li>
              <li class="flex items-start"><span style="flex-shrink:0;width:24px;height:24px;background:rgba(24,119,242,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#1877F2;font-size:12px;margin-right:10px;margin-top:2px">✓</span><span class="text-sm text-text-secondary">Solution recommendation</span></li>
              <li class="flex items-start"><span style="flex-shrink:0;width:24px;height:24px;background:rgba(24,119,242,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#1877F2;font-size:12px;margin-right:10px;margin-top:2px">✓</span><span class="text-sm text-text-secondary">No obligation, no pressure</span></li>
            </ul>
          </div>
          <div class="card">
            <h3 class="font-semibold text-navy mb-4">Prefer to Email?</h3>
            <p class="text-sm text-text-secondary mb-3">Send us an email and we'll respond within 24 hours.</p>
            <a href="mailto:info@myelektra.com" class="text-blue-600 hover:text-blue-800 font-medium text-sm">info@myelektra.com →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark section-padding">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title-white">{pageData.ctaHeadline}</h2>
      <p class="text-white/70 mb-8 max-w-2xl mx-auto">{pageData.ctaBody}</p>
      <a href={pageData.ctaButtonPath} class="btn btn-large">{pageData.ctaButtonLabel}</a>
    </div>
  </section>
</BaseLayout>
