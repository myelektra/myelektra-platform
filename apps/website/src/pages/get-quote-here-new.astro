---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Get a Quote" description="Request a custom quote from Myelektra.">
  <section class="section-light section-padding" style="background:linear-gradient(135deg, rgba(11,17,32,0.92), rgba(0,82,204,0.85));min-height:40vh;display:flex;align-items:center">
    <div class="hero-grid-bg"></div>
    <div class="hero-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Get a Quote</h1>
      <p class="text-lg md:text-xl text-white/80 max-w-3xl mx-auto">Tell us about your revenue goals and we'll create a custom solution tailored to your needs.</p>
    </div>
  </section>

  <section class="section-gray section-padding">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="card">
        <h2 class="text-2xl font-bold text-navy mb-6">Request a Custom Quote</h2>
        <form class="space-y-5" action="https://formsubmit.co/info@myelektra.com" method="POST">
          <input type="hidden" name="_subject" value="New Quote Request" />
          <input type="hidden" name="_captcha" value="false" />
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div><label class="block text-sm font-medium text-navy mb-1.5">First Name *</label><input type="text" name="firstName" required class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
            <div><label class="block text-sm font-medium text-navy mb-1.5">Last Name *</label><input type="text" name="lastName" required class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
          </div>
          <div><label class="block text-sm font-medium text-navy mb-1.5">Email *</label><input type="email" name="email" required class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
          <div><label class="block text-sm font-medium text-navy mb-1.5">Phone Number</label><input type="tel" name="phone" class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
          <div><label class="block text-sm font-medium text-navy mb-1.5">Company *</label><input type="text" name="company" required class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" /></div>
          <div><label class="block text-sm font-medium text-navy mb-1.5">Interested Solution</label>
            <select name="solution" class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white">
              <option value="">Select a solution</option>
              <option value="revenue-intelligence">Revenue Intelligence</option>
              <option value="pipeline-builder">Pipeline Builder</option>
              <option value="revenue-engine">Revenue Engine</option>
              <option value="ai-sales">AI Sales Transformation</option>
              <option value="fractional-revenue">Fractional Revenue Office</option>
              <option value="custom">Custom Package</option>
            </select>
          </div>
          <div><label class="block text-sm font-medium text-navy mb-1.5">Budget Range</label>
            <select name="budget" class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white">
              <option value="">Select budget range</option>
              <option value="under-1000">Under USD 1,000/mo</option>
              <option value="1000-5000">USD 1,000 – 5,000/mo</option>
              <option value="5000-10000">USD 5,000 – 10,000/mo</option>
              <option value="10000-plus">USD 10,000+/mo</option>
              <option value="not-sure">Not Sure</option>
            </select>
          </div>
          <div><label class="block text-sm font-medium text-navy mb-1.5">Project Details *</label><textarea name="details" required rows="5" class="w-full px-4 py-2.5 border border-border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none" placeholder="Describe your revenue goals, challenges, and what you're looking for..."></textarea></div>
          <button type="submit" class="btn btn-primary w-full" style="padding:14px">Request Quote</button>
        </form>
      </div>
      <div class="text-center mt-8">
        <p class="text-text-secondary text-sm">Prefer to talk? <a href="/consultation" class="text-blue-600 hover:text-blue-800 font-medium">Book a free consultation instead</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
