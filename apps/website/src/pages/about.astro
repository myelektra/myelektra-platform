---
import BaseLayout from '../layouts/BaseLayout.astro';
import { client } from '../../tina/__generated__/client';

let pageData = {
  title: 'About', description: 'AI-powered revenue growth partner.',
  heroHeadline: 'About Myelektra',
  heroSubtitle: 'We are an AI-powered revenue growth partner helping B2B companies move from scattered prospecting to structured, measurable revenue systems.',
  storyLabel: 'Our Story', storyHeadline: 'From Buyer Persona to Revenue Pipeline',
  storyParagraph1: 'Myelektra was founded with a clear observation: most B2B companies struggle not because they lack data, but because they lack a system. They have spreadsheets of contacts, lists of leads, and CRM databases — but no structured process to turn those into revenue.',
  storyParagraph2: 'Our approach combines AI-powered insights with human expertise to create revenue systems that are measurable, scalable, and sustainable. We help companies move from scattered prospecting to a structured, repeatable revenue engine.',
  missionHeadline: 'Our Mission', missionText: 'To help B2B companies build predictable revenue systems that combine technology, process, and people.',
  statsHeadline: 'Our Impact',
  ctaHeadline: 'Ready to Transform Your Revenue?',
  ctaBody: 'Book a discovery session to learn how Myelektra can help you build a structured revenue system.',
  ctaButtonLabel: 'Book an Online Meeting', ctaButtonPath: '/consultation'
};

try { const r = await client.request({ query: `query { page(relativePath: "about.mdx") { heroHeadline heroSubtitle storyLabel storyHeadline storyParagraph1 storyParagraph2 missionHeadline missionText statsHeadline ctaHeadline ctaBody ctaButtonLabel ctaButtonPath } }` }); if (r.data?.page) { const d = r.data.page; Object.keys(pageData).forEach(k => { if ((d as any)[k]) (pageData as any)[k] = (d as any)[k]; }); } } catch {}
---

<BaseLayout title={pageData.title} description={pageData.description}>
  <section class="section-light section-padding" style="background:linear-gradient(135deg, rgba(11,17,32,0.92), rgba(0,82,204,0.85));min-height:40vh;display:flex;align-items:center">
    <div class="hero-grid-bg"></div>
    <div class="hero-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{pageData.heroHeadline}</h1>
      <p class="text-lg md:text-xl text-white/80 max-w-3xl mx-auto">{pageData.heroSubtitle}</p>
    </div>
  </section>

  <section class="section-light section-padding">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-label">{pageData.storyLabel}</p>
        <h2 class="section-title">{pageData.storyHeadline}</h2>
        <div class="divider-line mt-4"></div>
      </div>
      <div class="space-y-6 max-w-3xl mx-auto">
        <p class="text-lg text-text-secondary leading-relaxed">{pageData.storyParagraph1}</p>
        <p class="text-lg text-text-secondary leading-relaxed">{pageData.storyParagraph2}</p>
      </div>
    </div>
  </section>

  <section class="section-dark section-padding">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="section-label" style="color:rgba(255,255,255,0.6)">{pageData.missionHeadline}</p>
      <h2 class="section-title-white">{pageData.missionText}</h2>
      <div class="divider-line mt-6"></div>
    </div>
  </section>

  <section class="section-gray section-padding">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-12">
      <h2 class="section-title">{pageData.statsHeadline}</h2>
      <div class="divider-line mt-4"></div>
    </div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card text-center">
          <div class="text-4xl font-bold text-teal mb-2">7+</div>
          <div class="text-text-secondary text-sm">Countries</div>
        </div>
        <div class="card text-center">
          <div class="text-4xl font-bold text-teal mb-2">5</div>
          <div class="text-text-secondary text-sm">Solutions</div>
        </div>
        <div class="card text-center">
          <div class="text-4xl font-bold text-teal mb-2">1</div>
          <div class="text-text-secondary text-sm">Integrated System</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark section-padding">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title-white">{pageData.ctaHeadline}</h2>
      <p class="text-white/70 mb-8 max-w-2xl mx-auto">{pageData.ctaBody}</p>
      <a href={pageData.ctaButtonPath} class="btn btn-large">{pageData.ctaButtonLabel}</a>
    </div>
  </section>
</BaseLayout>
