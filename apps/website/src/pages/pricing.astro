---
import BaseLayout from '../layouts/BaseLayout.astro';
import { client } from '../../tina/__generated__/client';

let pageData = {
  title: 'Pricing',
  description: 'Flexible pricing for every growth stage.',
  heroHeadline: 'Transparent Pricing',
  heroSubtitle: 'Choose the solution that fits your growth stage and budget. All plans are flexible and can be customized.',
  includedLabel: 'What\'s Included:',
  popularBadge: 'Most Popular',
  ctaHeadline: 'Not Sure Which Plan?',
  ctaBody: 'Book a call and we\'ll help you find the right solution.',
  ctaButtonLabel: 'Book an Online Meeting',
  ctaButtonPath: '/consultation'
};

try {
  const r = await client.request({
    query: `query { page(relativePath: "pricing.mdx") { heroHeadline heroSubtitle includedLabel popularBadge ctaHeadline ctaBody ctaButtonLabel ctaButtonPath } }`
  });
  if (r.data?.page) {
    const d = r.data.page;
    if (d.heroHeadline) pageData.heroHeadline = d.heroHeadline;
    if (d.heroSubtitle) pageData.heroSubtitle = d.heroSubtitle;
    if (d.includedLabel) pageData.includedLabel = d.includedLabel;
    if (d.popularBadge) pageData.popularBadge = d.popularBadge;
    if (d.ctaHeadline) pageData.ctaHeadline = d.ctaHeadline;
    if (d.ctaBody) pageData.ctaBody = d.ctaBody;
  }
} catch {}

const plans = [
  { name: 'Revenue Intelligence', price: '[Book Meeting]', desc: 'Build a focused market-entry and prospecting foundation.', icon: '📊', color: '#1877F2', popular: false, features: ['ICP development & market-entry analysis', 'Buyer persona mapping', 'Up to 300 verified contacts', 'Revenue opportunity report'] },
  { name: 'Pipeline Builder', price: 'USD x,xxx/mo', desc: 'Turn approved buyer personas into qualified conversations.', icon: '🔷', color: '#FFB800', popular: true, features: ['HubSpot CRM setup', 'AI-assisted prospecting', 'Human SDR follow-up', 'Weekly reporting'] },
  { name: 'Revenue Engine', price: 'USD x,xxx/mo', desc: 'Integrated system from prospecting to pipeline management.', icon: '⚙️', color: '#00C896', popular: false, features: ['Everything in Pipeline Builder', 'Workflow automation', 'Pipeline management', 'Revenue forecasting'] },
  { name: 'AI Sales Transformation', price: '[Book Meeting]', desc: 'Transform manual sales into AI-assisted workflows.', icon: '🤖', color: '#8B5CF6', popular: false, features: ['AI readiness assessment', 'HubSpot AI setup', 'AI sales playbook', 'Team training'] },
  { name: 'Fractional Revenue Office', price: 'USD x,xxx–xx,xxx/mo', desc: 'Senior revenue leadership without full-time hire.', icon: '🏢', color: '#1A73E8', popular: false, features: ['Revenue strategy & planning', 'SDR team management', 'Quarterly growth planning', 'Executive reporting'] },
];
---

<BaseLayout title={pageData.title} description={pageData.description}>
  <section class="section-light section-padding" style="background:linear-gradient(135deg, rgba(11,17,32,0.92), rgba(0,82,204,0.85));min-height:40vh;display:flex;align-items:center">
    <div class="hero-grid-bg"></div>
    <div class="hero-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{pageData.heroHeadline}</h1>
      <p class="text-lg md:text-xl text-white/80 max-w-3xl mx-auto">{pageData.heroSubtitle}</p>
    </div>
  </section>

  <section class="section-gray section-padding">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {plans.map((plan) => (
          <div class="solution-card" class:list={{ featured: plan.popular }}>
            {plan.popular && <div class="badge-popular">{pageData.popularBadge}</div>}
            <div style="font-size:40px;margin-bottom:16px">{plan.icon}</div>
            <h3 class="card-title">{plan.name}</h3>
            <p class="solution-price">{plan.price}</p>
            <p class="card-desc mb-4">{plan.desc}</p>
            <div class="mb-3">
              <h4 class="text-xs font-semibold text-teal uppercase tracking-wider mb-2">{pageData.includedLabel}</h4>
            </div>
            <ul class="feature-list">
              {plan.features.map((f: string) => (
                <li class="feature-item"><span class="feature-check">✓</span>{f}</li>
              ))}
            </ul>
            <a href="/consultation" class="learn-more">Get Started <span>→</span></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-dark section-padding">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="section-title-white">{pageData.ctaHeadline}</h2>
      <p class="text-white/70 mb-8 max-w-2xl mx-auto">{pageData.ctaBody}</p>
      <a href={pageData.ctaButtonPath} class="btn btn-large">{pageData.ctaButtonLabel}</a>
    </div>
  </section>
</BaseLayout>
