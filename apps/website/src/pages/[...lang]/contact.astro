---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import ContactSection from "@/components/sections/ContactSection.astro";
import overrideObjects from "@/lib/utils/overrideObjects";

export function getStaticPaths() {
  return generatePaths();
}

const meta = { title: 'Contact', description: 'Get in touch with Myelektra.' };
---

<Base {...meta}>
  <section class="section-light section-padding" style="background:linear-gradient(135deg, rgba(11,17,32,0.92), rgba(0,82,204,0.85));min-height:40vh;display:flex;align-items:center">
    <div class="hero-grid-bg"></div>
    <div class="hero-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Contact Us</h1>
      <p class="text-lg md:text-xl text-white/80 max-w-3xl mx-auto">Get in touch with our team to discuss how Myelektra can help grow your revenue.</p>
    </div>
  </section>

  <section class="py-20" style="background:#f8f9fc">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold mb-8" style="color:#0B1120">Get In Touch</h2>
          <div class="space-y-6">
            <div class="flex items-start">
              <div style="flex-shrink:0;width:44px;height:44px;background:rgba(24,119,242,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center" data-lucide="Phone" style="color:#1877F2;width:18px;height:18px"></div>
              <div class="ml-4"><h3 class="font-semibold" style="color:#0B1120">Phone</h3><p style="color:rgba(11,17,32,0.6)">+62 21 29636761</p></div>
            </div>
            <div class="flex items-start">
              <div style="flex-shrink:0;width:44px;height:44px;background:rgba(24,119,242,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center" data-lucide="Mail" style="color:#1877F2;width:18px;height:18px"></div>
              <div class="ml-4"><h3 class="font-semibold" style="color:#0B1120">Email</h3><p style="color:rgba(11,17,32,0.6)">info@myelektra.com</p></div>
            </div>
            <div class="flex items-start">
              <div style="flex-shrink:0;width:44px;height:44px;background:rgba(24,119,242,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center" data-lucide="MapPin" style="color:#1877F2;width:18px;height:18px"></div>
              <div class="ml-4"><h3 class="font-semibold" style="color:#0B1120">Corporate Office</h3><p style="color:rgba(11,17,32,0.6)">38th Floor, 88 Office<br />Kota Kasablanka, South Jakarta<br />Indonesia</p></div>
            </div>
            <div class="flex items-start">
              <div style="flex-shrink:0;width:44px;height:44px;background:rgba(24,119,242,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center" data-lucide="Clock" style="color:#1877F2;width:18px;height:18px"></div>
              <div class="ml-4"><h3 class="font-semibold" style="color:#0B1120">Business Hours</h3><p style="color:rgba(11,17,32,0.6)">Weekdays / 9:00 – 18:00</p></div>
            </div>
          </div>
        </div>

        <div class="card">
          <h2 class="text-2xl font-bold mb-6" style="color:#0B1120">Send Us a Message</h2>
          <form class="space-y-5" action="https://formsubmit.co/info@myelektra.com" method="POST">
            <input type="hidden" name="_subject" value="New Contact Message" />
            <input type="hidden" name="_captcha" value="false" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div><label class="block text-sm font-medium mb-1.5" style="color:#0B1120">First Name *</label><input type="text" required class="w-full px-4 py-2.5 border rounded-lg" style="border-color:rgba(11,17,32,0.15)" /></div>
              <div><label class="block text-sm font-medium mb-1.5" style="color:#0B1120">Last Name *</label><input type="text" required class="w-full px-4 py-2.5 border rounded-lg" style="border-color:rgba(11,17,32,0.15)" /></div>
            </div>
            <div><label class="block text-sm font-medium mb-1.5" style="color:#0B1120">Email *</label><input type="email" required class="w-full px-4 py-2.5 border rounded-lg" style="border-color:rgba(11,17,32,0.15)" /></div>
            <div><label class="block text-sm font-medium mb-1.5" style="color:#0B1120">Company</label><input type="text" class="w-full px-4 py-2.5 border rounded-lg" style="border-color:rgba(11,17,32,0.15)" /></div>
            <div><label class="block text-sm font-medium mb-1.5" style="color:#0B1120">Message *</label><textarea rows="4" required class="w-full px-4 py-2.5 border rounded-lg" style="border-color:rgba(11,17,32,0.15)" placeholder="How can we help you?"></textarea></div>
            <button type="submit" class="w-full py-3 px-6 rounded-lg text-white font-semibold" style="background:#1877F2">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</Base>
